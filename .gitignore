# Conda environment (workspace-provided, never commit)
.conda/

# Scratch data and local caches
.tmp/
.pkgs/
.env
.env.*
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log
*.bak
*.orig
*.rej

# Build output
build/
dist/
*.spec

# Private keys and SSH material — never commit these
.ssh/
id_rsa*
id_ed25519*
id_ecdsa*
*.pem
*.key
*.ppk

# Editors / OS
.idea/
.vscode/*
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini
